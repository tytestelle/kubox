<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:gravity="start|center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:background="@drawable/item_bg_selector_right">
    <LinearLayout
        android:id="@+id/channelNumLayout"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvChannelNum"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:minWidth="32dp"
            android:gravity="center"
            android:background="@drawable/shape_channel_num_bg"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true" />
    </LinearLayout>
    <ImageView
        android:id="@+id/ivChannelLogo"
        android:layout_width="52dp"
        android:layout_height="30dp"
        android:layout_marginStart="5dp"
        android:scaleType="centerInside" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginStart="7dp">
        <TextView
            android:id="@+id/tvChannelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/tvCurrentProgram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:textColor="@color/color_FFFFFF_50"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>