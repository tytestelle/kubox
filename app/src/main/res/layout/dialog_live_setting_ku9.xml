<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="760dp" android:layout_height="520dp" android:orientation="horizontal"
    android:padding="14dp" android:background="@drawable/shape_live_setting_dialog_bg"
    android:focusable="true" android:focusableInTouchMode="true">
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/ku9SettingGroupView" android:layout_width="210dp" android:layout_height="match_parent"
        android:padding="6dp" android:scrollbars="none" android:descendantFocusability="afterDescendants" />
    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#33FFFFFF" />
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/ku9SettingItemView" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:padding="6dp" android:scrollbars="none" android:descendantFocusability="afterDescendants" />
</LinearLayout>
